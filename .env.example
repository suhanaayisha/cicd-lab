# Copy to .env for local development: cp .env.example .env

PORT=3000

# MongoDB. Start a local one with: npm run db:start
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=menus

# MongoDB server used by the tests. Never point this at production.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017

# Base URL encoded in QR codes. Leave unset locally; set it in production,
# e.g. PUBLIC_URL=https://menuqr.onrender.com
# PUBLIC_URL=

# Where uploaded PDFs are stored: local (a folder on disk) or r2 (Cloudflare R2).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads

# Required when STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
